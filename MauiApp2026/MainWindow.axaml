<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MauiApp2026.MainWindow"
        Title="MauiApp2026">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" 
                   Text="Welcome to Avalonia UI"
                   Padding="20"
                   FontSize="24"
                   FontWeight="Bold" />
        
        <Border Padding="20">
            <StackPanel Spacing="10">
                <TextBlock Text="Dashboard" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="Projects" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="Manage Meta" FontSize="18" FontWeight="Bold" />
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
