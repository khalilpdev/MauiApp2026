<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MauiApp2026.Views.ProjectsView">
    <Grid ColumnDefinitions="*" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0"
                   Text="Projects"
                   Padding="20"
                   FontSize="28"
                   FontWeight="Bold" />
        
        <Border Grid.Row="1" Padding="20">
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                    <TextBlock Text="Manage Your Projects" FontSize="18" VerticalAlignment="Center" />
                    <Button Content="+ Add New" Padding="10,5" />
                </StackPanel>
                
                <ItemsControl ItemsSource="{Binding CurrentViewModel.Projects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10" Background="#FFFFFF">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Icon}" FontSize="32" VerticalAlignment="Top" />
                                    
                                    <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Spacing="8" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" />
                                        <TextBlock Text="{Binding Description}" Foreground="#666666" FontSize="13" />
                                        <TextBlock Text="{Binding Category.Title}" Foreground="#0078D4" FontSize="12" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Tasks.Count}" FontSize="20" FontWeight="Bold" />
                                        <TextBlock Text="tasks" FontSize="12" Foreground="#999999" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
